nextflow_workflow {
    name "Test Subworkflow VARPIPE_VARIANTANALYSIS"
    script "../main.nf"
    workflow "VARPIPE_VARIANTANALYSIS"
    config "./nextflow.config"

    tag "subworkflows"
    tag "subworkflows_phcore"
    tag "subworkflows/varpipe_variantanalysis"
    tag "untar"
    tag "gatk4/leftalignandtrimvariants"
    tag "gatk4/mutect2"
    tag "gatk4/filtermutectcalls"
    tag "snpeff/snpeff"

    test("varpipe-variantanalysis subworkflow test") {
        when {
            params {
                outdir = "$outputDir"
                workdir = "$workDir"
            }
            workflow {
                """
                // Prepare input channels
                input[0] = Channel.of(
                    [
                        [ id:'test' ],
                        file(params.modules_testdata_base_path + "/genomics/bacterial/tuberculosis/bam/test.bam", checkIfExists: true),
                        file(params.modules_testdata_base_path + "/genomics/bacterial/tuberculosis/bam/test.bai", checkIfExists: true),
                        []
                    ]
                )

                input[1] = Channel.of(
                    [
                        [ id:'test' ],
                        file(params.modules_testdata_base_path + "/genomics/bacterial/tuberculosis/bam/test.bam", checkIfExists: true),
                        file(params.modules_testdata_base_path + "/genomics/bacterial/tuberculosis/bam/test.bai", checkIfExists: true),
                        file(params.modules_testdata_base_path + '/genomics/bacterial/tuberculosis/genome/kb/varpipe/intervals.bed', checkIfExists: true) ]
                )

                input[2] = Channel.of(
                    [
                        [ id:'test' ],
                        file(params.modules_testdata_base_path + "/genomics/bacterial/tuberculosis/genome/reference-index/ref2.fa.fai", checkIfExists: true)
                    ]
                )

                input[3] = Channel.of(
                    [
                        [ id:'test' ],
                        file(params.modules_testdata_base_path + "/genomics/bacterial/tuberculosis/genome/reference-index/ref2.dict", checkIfExists: true)
                    ]
                )

                input[4] = Channel.of(
                    [
                        [ id:'fasta' ],
                        file(params.modules_testdata_base_path + "/genomics/bacterial/tuberculosis/genome/kb/varpipe/ref2.fa", checkIfExists: true)
                    ]
                )
                input[5] = "mtb_NC_000962_3"
                input[6] = params.snpeff_cache
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.ann_targeted.size() > 0 },
                { assert workflow.out.ann_all.size() > 0 },
                { assert workflow.out.multiqc_inputs.size() > 0 },
                { assert snapshot(
                        workflow.out.versions
                    ).match()
                }
            )
        }
    }

}
