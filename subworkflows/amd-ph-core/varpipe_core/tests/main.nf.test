nextflow_workflow {

    name "Test Subworkflow VARPIPE_CORE"
    script "../main.nf"
    workflow "VARPIPE_CORE"
    config "./nextflow.config"

    tag "subworkflows"
    tag "subworkflows_amdphcore"
    tag "subworkflows/varpipe_core"
    tag "modules/nf-core/cat/fastq"
    tag "subworkflows/../../modules/nf-core/trimmomatic"
    tag "subworkflows/varpipe_processbam"
    tag "varpipe/coverageanalysis"
    tag "varpipe/structuralvariants"
    tag "subworkflows/varpipe_variantanalysis"
    tag "varpipe/createannotations"
    tag "varpipe/parseannotations"
    tag "varpipe/lineage"
    tag "varpipe/report"
    tag "varpipe/interpretation"
    tag "varpipe/pdf"
    tag "varpipe/tar"
    tag "modules/nf-core/untar"

    setup {
        nfcoreInitialise("${launchDir}/library/")
        nfcoreInstall(
            "${launchDir}/library/",
            [
                [name: "cat/fastq",                       sha: "d090922b1a4b80ba283186459ababf8e308abcbb"],
                [name: "trimmomatic",                     sha: "d090922b1a4b80ba283186459ababf8e308abcbb"],
                [name: "bwa/index",                       sha: "d090922b1a4b80ba283186459ababf8e308abcbb"],
                [name: "picard/createsequencedictionary", sha: "d090922b1a4b80ba283186459ababf8e308abcbb"],
                [name: "samtools/faidx",                  sha: "d090922b1a4b80ba283186459ababf8e308abcbb"],
                [name: "picard/markduplicates",           sha: "d090922b1a4b80ba283186459ababf8e308abcbb"],
                [name: "samtools/view",                   sha: "d090922b1a4b80ba283186459ababf8e308abcbb"],
                [name: "samtools/depth",                  sha: "d090922b1a4b80ba283186459ababf8e308abcbb"],
                [name: "gatk4/mutect2",                   sha: "d090922b1a4b80ba283186459ababf8e308abcbb"],
                [name: "gatk4/leftalignandtrimvariants",  sha: "d090922b1a4b80ba283186459ababf8e308abcbb"],
                [name: "gatk4/filtermutectcalls",         sha: "d090922b1a4b80ba283186459ababf8e308abcbb"],
                [name: "snpeff/snpeff",                   sha: "d090922b1a4b80ba283186459ababf8e308abcbb"],
                [name: "untar",                           sha: "d090922b1a4b80ba283186459ababf8e308abcbb"]
            ]
        )
        nfcoreLink("${launchDir}/library/", "${baseDir}/modules/")
        run("UNTAR", alias: "UNTAR_SNPEFF") {
            script "../../../../modules/nf-core/untar/main.nf"
            process {
                """
                input[0] = Channel.of([
                    [id: "snpeff_cache"],
                    file(
                        params.modules_testdata_base_path + "/genomics/bacterial/tuberculosis/genome/kb/snpeff_cache.tar.gz",
                        checkIfExists: true
                    )
                ])
                """
            }
        }
        run("CAT_FASTQ") {
            script "../../../../modules/nf-core/cat/fastq/main.nf"
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ], // meta map
                    [
                    file(params.modules_testdata_base_path + "/genomics/bacterial/tuberculosis/fastqs/SRR24827267_1.part_001.fastq.gz"),
                    file(params.modules_testdata_base_path + "/genomics/bacterial/tuberculosis/fastqs/SRR24827267_2.part_001.fastq.gz"),
                    file(params.modules_testdata_base_path + "/genomics/bacterial/tuberculosis/fastqs/SRR24827267_1.part_002.fastq.gz"),
                    file(params.modules_testdata_base_path + "/genomics/bacterial/tuberculosis/fastqs/SRR24827267_2.part_002.fastq.gz"),
                    file(params.modules_testdata_base_path + "/genomics/bacterial/tuberculosis/fastqs/SRR24827267_1.part_003.fastq.gz"),
                    file(params.modules_testdata_base_path + "/genomics/bacterial/tuberculosis/fastqs/SRR24827267_2.part_003.fastq.gz"),
                    file(params.modules_testdata_base_path + "/genomics/bacterial/tuberculosis/fastqs/SRR24827267_1.part_004.fastq.gz"),
                    file(params.modules_testdata_base_path + "/genomics/bacterial/tuberculosis/fastqs/SRR24827267_2.part_004.fastq.gz")
                    ]
                ])
                """
            }
        }
    }

    test("varpipe-core subworkflow test [paired-end]") {

        when {
            params {
                date = "TEST_DATESTAMP"
                keepfiles = false
            }
            workflow {
                """
                input[0] = CAT_FASTQ.out.reads
                input[1] = params.date
                input[2] = file(params.modules_testdata_base_path + '/genomics/bacterial/tuberculosis/genome/kb/varpipe/ref2.fa')
                input[3] = file(params.modules_testdata_base_path + '/genomics/bacterial/tuberculosis/genome/kb/varpipe/amp_bed.txt')
                input[4] = file(params.modules_testdata_base_path + '/genomics/bacterial/tuberculosis/genome/kb/varpipe/bed_1.txt')
                input[5] = file(params.modules_testdata_base_path + '/genomics/bacterial/tuberculosis/genome/kb/varpipe/bed_2.txt')
                input[6] = file(params.modules_testdata_base_path + '/genomics/bacterial/tuberculosis/genome/kb/varpipe/BED.txt')
                input[7] = file(params.modules_testdata_base_path + '/genomics/bacterial/tuberculosis/genome/kb/varpipe/mutation_loci.txt')
                input[8] = file(params.modules_testdata_base_path + '/genomics/bacterial/tuberculosis/genome/kb/varpipe/intervals.bed')
                input[9] = file(params.modules_testdata_base_path + '/genomics/bacterial/tuberculosis/genome/kb/varpipe/reportable.txt')
                input[10] = file(params.modules_testdata_base_path + '/genomics/bacterial/tuberculosis/genome/kb/varpipe/lineage_markers.txt')
                input[11] = "mtb_NC_000962_3"
                input[12] = UNTAR_SNPEFF.out.untar.map{ meta, cache -> cache }
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.multiqc_inputs.size() > 0 },
                { assert snapshot(
                        workflow.out.lineage,
                        workflow.out.versions
                    ).match()
                }
            )
        }

        cleanup {
            nfcoreUnlink("${launchDir}/library/", "${baseDir}/modules/nf-core")
        }
    }
}
