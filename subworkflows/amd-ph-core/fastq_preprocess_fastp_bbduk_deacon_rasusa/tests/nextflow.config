process {
    // Adapter trimming only: no quality, length or poly-G trimming, so the read counts the tests
    // assert on are fastp's input counts. Duplication evaluation stays on as a QC metric.
    withName: FASTP {
        ext.args = '--disable_quality_filtering --disable_length_filtering --disable_trim_poly_g'
    }
    withName: FASTPLONG {
        ext.args = '--disable_quality_filtering --disable_length_filtering'
    }
    // The k QQQ runs at; see the bbduk module's meta.yml for the measurement behind it.
    withName: BBMAP_BBDUK {
        ext.args = 'k=25'
    }
    // Keep reads in input order, so the mates of a pair stay in step in both outputs.
    withName: DEACON_FILTER {
        ext.args = '--ordered'
    }
}
