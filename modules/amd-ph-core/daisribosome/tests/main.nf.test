nextflow_process {

    name "Test Process DAISRIBOSOME"
    script "../main.nf"
    process "DAISRIBOSOME"
    config "./nextflow.config"

    tag "modules"
    tag "modules_amdphcore"
    tag "daisribosome"

    // Row order within ribosome's outputs is not guaranteed across runs, so
    // content is hashed after sorting lines rather than compared byte-for-byte
    // (confirmed reproducible across repeat runs at cpus=1). Coordinate-level
    // annotation accuracy is ribosome's own concern; these tests only confirm
    // the wrapper invokes it correctly and stages its outputs.

    test("influenza - full bundled reference - flu") {

        setup {
            run("EXTRACT_REFERENCE") {
                script "./extract_reference.nf"
                process {
                    """
                    input[0] = Channel.of([ [ id:'influenza_full' ], "flu" ])
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = EXTRACT_REFERENCE.out.fasta
                input[1] = "flu"
                """
            }
        }

        then {
            def sortedMd5 = { f -> f.readLines().sort().join("\n").bytes.md5() }
            def productSeq = path(process.out.product_seq[0][1])
            def genomeSeq  = path(process.out.genome_seq[0][1])
            def auxiliaryOutputs = [
                [path(process.out.product_ins[0][1]), "influenza_full.ins.txt"],
                [path(process.out.product_del[0][1]), "influenza_full.del.txt"],
                [path(process.out.genome_ins[0][1]),  "influenza_full.gen_ins.txt"],
                [path(process.out.genome_del[0][1]),  "influenza_full.gen_del.txt"]
            ]

            assertAll(
                { assert process.success },
                { assert process.out.product_seq[0][0].id == "influenza_full" },
                { assert productSeq.getFileName().toString() == "influenza_full.seq.txt" },
                { assert sortedMd5(productSeq) == "2c04e6c710aa54644062e7cc6bcb07f4" },
                { assert genomeSeq.getFileName().toString() == "influenza_full.gen_seq.txt" },
                { assert sortedMd5(genomeSeq) == "073b6faca4a9e04ea5994b94ee33be29" },
                {
                    auxiliaryOutputs.each { output, expectedName ->
                        assert output.getFileName().toString() == expectedName
                        assert output.toFile().isFile()
                    }
                },
                { assert process.out.versions_daisribosome == [["DAISRIBOSOME", "dais-ribosome", "2.1.0"]] },
                { assert snapshot(process.out.versions_daisribosome).match() }
            )
        }
    }

