        then {
            def sortedMd5 = { f -> f.readLines().sort().join("\n").bytes.md5() }
            def productSeq = path(process.out.product_seq[0][1])
            def genomeSeq  = path(process.out.genome_seq[0][1])
            def auxiliaryOutputs = [
                [path(process.out.product_ins[0][1]), "rsv_full.ins.txt"],
                [path(process.out.product_del[0][1]), "rsv_full.del.txt"],
                [path(process.out.genome_ins[0][1]),  "rsv_full.gen_ins.txt"],
                [path(process.out.genome_del[0][1]),  "rsv_full.gen_del.txt"]
            ]

            assertAll(
                { assert process.success },
                { assert productSeq.getFileName().toString() == "rsv_full.seq.txt" },
                { assert sortedMd5(productSeq) == "60b96ead62eeb700b3c96d5ad54584e5" },
                { assert genomeSeq.getFileName().toString() == "rsv_full.gen_seq.txt" },
                { assert sortedMd5(genomeSeq) == "216c1080f0d251f499685329a84c3c3b" },
                {
                    auxiliaryOutputs.each { output, expectedName ->
                        assert output.getFileName().toString() == expectedName
                        assert output.toFile().isFile()
