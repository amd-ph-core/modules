    test("sarscov2 - full bundled reference - cov - default ctype") {

        config "./default_ctype.config"

        setup {
            run("EXTRACT_REFERENCE") {
                script "./extract_reference.nf"
                process {
                    """
                    input[0] = Channel.of([ [ id:'sarscov2_default_ctype' ], "cov" ])
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = EXTRACT_REFERENCE.out.fasta
                input[1] = "cov"
                """
            }
        }

        then {
            // Only confirms ext.args reaches ribosome and the module still
            // succeeds; whether the flag changes ribosome's output is not
            // this wrapper's concern.
            assertAll(
                { assert process.success },
                { assert path(process.out.product_seq[0][1]).getFileName().toString() == "sarscov2_default_ctype.seq.txt" },
                { assert path(process.out.genome_seq[0][1]).toFile().isFile() },
                { assert process.out.versions_daisribosome == [["DAISRIBOSOME", "dais-ribosome", "2.1.0"]] }
            )
        }
    }

    test("sarscov2 - unclassifiable record - cov") {

        when {
            process {
                """
                def unclassifiable = new File("${outputDir}/sarscov2_unclassifiable.tsv")
                unclassifiable.text = "bogus_record\\tNOT_A_CTYPE\\tACGTACGTACGT\\n"
                input[0] = Channel.of([
                    [ id:'sarscov2_unclassifiable' ],
                    file(unclassifiable.path)
                ])
                input[1] = "cov"
                """
            }
        }

        then {
            def outputs = [
                [path(process.out.product_seq[0][1]), "sarscov2_unclassifiable.seq.txt"],
                [path(process.out.product_ins[0][1]), "sarscov2_unclassifiable.ins.txt"],
                [path(process.out.product_del[0][1]), "sarscov2_unclassifiable.del.txt"],
                [path(process.out.genome_seq[0][1]),  "sarscov2_unclassifiable.gen_seq.txt"],
                [path(process.out.genome_ins[0][1]),  "sarscov2_unclassifiable.gen_ins.txt"],
                [path(process.out.genome_del[0][1]),  "sarscov2_unclassifiable.gen_del.txt"]
            ]

            // An unrecognized ctype is not an error: ribosome exits 0 and writes
            // every output empty, reporting the record only on stderr.
            assertAll(
                { assert process.success },
                {
                    outputs.each { output, expectedName ->
                        assert output.getFileName().toString() == expectedName
                        assert output.toFile().isFile()
                        assert output.toFile().length() == 0
                    }
                },
                { assert process.out.versions_daisribosome == [["DAISRIBOSOME", "dais-ribosome", "2.1.0"]] },
                { assert snapshot(process.out.versions_daisribosome).match() }
            )
        }
    }

    test("rsv - full bundled reference - rsv") {

        setup {
            run("EXTRACT_REFERENCE") {
