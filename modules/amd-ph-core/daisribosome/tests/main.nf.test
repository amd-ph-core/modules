    }

    test("influenza - full bundled reference - flu - stub") {

        options "-stub"

        setup {
            run("EXTRACT_REFERENCE") {
                script "./extract_reference.nf"
                process {
                    """
                    input[0] = Channel.of([ [ id:'influenza_stub' ], "flu" ])
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = EXTRACT_REFERENCE.out.fasta
                input[1] = "flu"
                """
