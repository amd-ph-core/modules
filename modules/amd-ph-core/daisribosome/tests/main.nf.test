        }

        then {
            def outputs = [
                [path(process.out.product_seq[0][1]), "influenza_stub.seq.txt"],
                [path(process.out.product_ins[0][1]), "influenza_stub.ins.txt"],
                [path(process.out.product_del[0][1]), "influenza_stub.del.txt"],
                [path(process.out.genome_seq[0][1]),  "influenza_stub.gen_seq.txt"],
                [path(process.out.genome_ins[0][1]),  "influenza_stub.gen_ins.txt"],
