nextflow_process {

    name "Test Process MMSEQS_TRANSLATEDSEARCH"
    script "../main.nf"
    process "MMSEQS_TRANSLATEDSEARCH"

    tag "modules"
    tag "modules_amdphcore"
    tag "mmseqs"
    tag "mmseqs/translatedsearch"

    // Stub only, for a specific reason rather than convenience: this module takes a PREBUILT
    // MMseqs2 target database, and that is not a detail of the test setup -- it is the module's
    // interface. `createdb` on the ~1.1M-ORF protein target is the dominant cost of a one-off
    // search, so building it per sample would swamp the ~100 s the search itself takes, and the
    // module therefore has no code path that accepts a FASTA target to build on the fly. There
    // is no such database in any public test-data repository, and a stand-in built from a few
    // sarscov2 proteins would exercise the plumbing while testing nothing about the search.
    //
    // The search behaviour IS measured, on the residual of a 200,000-pair rRNA-depleted
    // wastewater library: 67.5% of the remaining pool recruited at ~2,000 pairs/s and 2.4 GB
    // peak on 14 threads, recovering 99.4-99.7% of what `blastn -word_size 11` found and adding
    // a further 23-32%, with ZERO rRNA-only best hits across 3,000 adjudicated pairs even
    // though rRNA ORFs were 90% of the target database by record count. See the binman
    // pipeline's docs/ for that measurement.

    test("stub - paired end") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    [
                        file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match("paired_stub") }
            )
        }
    }

    test("stub - single end") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ],
                    file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true)
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match("single_stub") }
            )
        }
    }
}
