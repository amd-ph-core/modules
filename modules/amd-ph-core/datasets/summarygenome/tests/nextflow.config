// The "current" arm deliberately does NOT override `container`. It runs whatever
// the module declares, so the snapshot tracks the image that actually ships
// rather than a second one pinned only here -- the previous version pointed at an
// OAMD ECR tag, which meant the published snapshot was produced by an image no
// external consumer could pull.
//
// Only `ext.args` is set. `--assembly-level complete` is what makes the result a
// stable two-row answer, so the snapshot tracks the container rather than NCBI's
// growth.
process {
    withName: DATASETS_SUMMARYGENOME {
        ext.args = '--assembly-source all --assembly-level complete'
    }
}
