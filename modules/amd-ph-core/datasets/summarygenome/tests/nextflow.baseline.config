// Older public baseline, identical in every respect to nextflow.config except
// the image. This arm exists to prove the `*_major` snapshot is stable across
// container versions, which is the property a consumer relies on when it pins a
// snapshot and later bumps the image.
//
// 18.15.0 and the module's 18.35.0 are both StaPH-B builds on quay.io. Both names
// are fully qualified, so no `docker.registry` clearing is needed: Nextflow
// prepends that setting only to an image name that has no registry host of its
// own.
process {
    withName: DATASETS_SUMMARYGENOME {
        container = 'quay.io/staphb/ncbi-datasets:18.15.0'
        ext.args  = '--assembly-source all --assembly-level complete'
    }
}
