nextflow_process {

    name "Test Process HOSTESS"
    script "../main.nf"
    process "HOSTESS"

    tag "modules"
    tag "modules_amdphcore"
    tag "hostess"

    // Stub tests only. No hostess image is published yet, so the real script
    // path cannot run in CI; tests/config/nf-test.config points HOSTESS at a
    // generic ubuntu image, which is all the stub needs. Replace these with
    // real tests once the image exists.

    test("sarscov2 - fastq - paired_end - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                      file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true) ]
                ])
                input[1] = Channel.value(['genome', file("\${projectDir}/modules/amd-ph-core/hostess/tests/ref", checkIfExists: true)])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.fastq[0][1].size() == 2 },
                // The BAM outputs are optional and --bam was not passed, so
                // asking for them must yield nothing rather than failing.
                { assert process.out.bam.size() == 0 },
                { assert process.out.bai.size() == 0 },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("sarscov2 - fastq - paired_end - bam - stub") {

        options "-stub"
        config "./bam.config"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                      file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true) ]
                ])
                input[1] = Channel.value(['genome', file("\${projectDir}/modules/amd-ph-core/hostess/tests/ref", checkIfExists: true)])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // With --bam the removed reads and their statistics appear.
                { assert process.out.bam[0][1] ==~ ".*/test.host.bam" },
                { assert process.out.bai[0][1] ==~ ".*/test.host.bam.bai" },
                { assert process.out.flagstat.size() == 1 },
                { assert process.out.stats.size() == 1 },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("sarscov2 - fastq - single_end - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:true ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true) ]
                ])
                input[1] = Channel.value(['genome', file("\${projectDir}/modules/amd-ph-core/hostess/tests/ref", checkIfExists: true)])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // One unpaired output, not a mate pair.
                { assert process.out.fastq[0][1] ==~ ".*/test.clean.fastq.gz" },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
