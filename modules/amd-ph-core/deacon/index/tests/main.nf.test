nextflow_process {

    name "Test Process DEACON_INDEX"
    script "../main.nf"
    process "DEACON_INDEX"

    tag "modules"
    tag "modules_amdphcore"
    tag "deacon"
    tag "deacon/index"

    test("sarscov2 - genome - fasta") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'sarscov2' ],
                    file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.index[0][1] ==~ ".*/sarscov2.idx" },
                { assert snapshot(
                    process.out.index,
                    process.out.versions_deacon
                ).match() }
            )
        }
    }

    test("sarscov2 - genome - fasta - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'sarscov2' ],
                    file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
