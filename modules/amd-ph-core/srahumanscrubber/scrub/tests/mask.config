process {
    withName: 'SRAHUMANSCRUBBER_SCRUB' {
        // No -x: aligns_to masks identified reads (every base N) by default. Set
        // explicitly, as remove.config sets -x, so the test asks for mask mode itself
        // rather than inheriting whatever ext.args a pipeline's modules.config sets.
        // Used by the mask tests and the stub test (the module's no-argument default).
        ext.args = ''
    }
}
