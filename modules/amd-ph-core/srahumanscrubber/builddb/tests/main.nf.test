nextflow_process {

    name "Test Process SRAHUMANSCRUBBER_BUILDDB"
    script "../main.nf"
    process "SRAHUMANSCRUBBER_BUILDDB"

    tag "modules"
    tag "modules_amdphcore"
    tag "srahumanscrubber"
    tag "srahumanscrubber/builddb"

    // Stub tests only. The STAT tools have no public image, so the real script path
    // cannot run in CI; tests/config/nf-test.config
    // points SRAHUMANSCRUBBER_BUILDDB at a generic ubuntu image, which is all the stub
    // needs. real.nf.test.disabled holds the real-path tests, run locally against
    // an image that carries the STAT tools (see its header).

    test("homo_sapiens - fasta - window 32 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'chr22_test' ],
                    file(params.nfcore_modules_testdata_base_path + '/genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                ])
                input[1] = []
                input[2] = 32
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.json[0][1]).text.contains('"window": 32') },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("homo_sapiens - fasta - protect - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'chr22_test_protected' ],
                    file(params.nfcore_modules_testdata_base_path + '/genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                ])
                input[1] = file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                input[2] = 32
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.json[0][1]).text.contains('"protect_files": 1') },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
