nextflow_process {

    name "Test Process CLOCKWORK_MINIMAP2"
    script "../main.nf"
    process "CLOCKWORK_MINIMAP2"

    tag "modules"
    tag "modules_amdphcore"
    tag "clockwork"
    tag "clockwork/minimap2"

    test("minimap2") {

        when {
            process {
                """
                // define inputs of the process here. Example:
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    [ file(params.modules_testdata_base_path + '/genomics/bacterial/tuberculosis/fastqs/test_1.fastq.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/genomics/bacterial/tuberculosis/fastqs/test_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                input[1] = file(params.modules_testdata_base_path + '/genomics/bacterial/tuberculosis/genome/kb/clockwork/ref_preprocessing.fa.gz', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(
                bam(process.out.sam[0][1]).getReadsMD5(),
                process.out.versions
            ).match()
        }

    }

    test("minimap2 - stub") {

        options "-stub"

        when {
            process {
                """
                // define inputs of the process here. Example:
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    [ file(params.modules_testdata_base_path + '/genomics/bacterial/tuberculosis/fastqs/test_1.fastq.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + '/genomics/bacterial/tuberculosis/fastqs/test_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                input[1] = file(params.modules_testdata_base_path + '/genomics/bacterial/tuberculosis/genome/kb/clockwork/ref_preprocessing.fa.gz', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
