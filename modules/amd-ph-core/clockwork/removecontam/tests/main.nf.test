nextflow_process {

    name "Test Process CLOCKWORK_REMOVECONTAM"
    script "../main.nf"
    process "CLOCKWORK_REMOVECONTAM"

    tag "modules"
    tag "modules_amdphcore"
    tag "clockwork"
    tag "clockwork/removecontam"

    test("clockwork removecontam") {

        when {
            process {
                """
                // define inputs of the process here. Example:
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    file(params.modules_testdata_base_path + '/genomics/bacterial/tuberculosis/bam/test2.sam', checkIfExists: true)
                    ]
                input[1] = file(params.modules_testdata_base_path + '/genomics/bacterial/tuberculosis/genome/kb/clockwork/remove_contam_metadata_preprocessing.tsv', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("clockwork removecontam - stub") {

        options "-stub"

        when {
            process {
                """
                // define inputs of the process here. Example:
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    file(params.modules_testdata_base_path + '/genomics/bacterial/tuberculosis/bam/test2.sam', checkIfExists: true)
                    ]
                input[1] = file(params.modules_testdata_base_path + '/genomics/bacterial/tuberculosis/genome/kb/clockwork/remove_contam_metadata_preprocessing.tsv', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out.versions).match()
        }

    }

}
