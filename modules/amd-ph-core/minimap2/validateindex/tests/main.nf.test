nextflow_process {

    name "Test Process MINIMAP2_VALIDATEINDEX"
    script "../main.nf"
    process "MINIMAP2_VALIDATEINDEX"
    config "./nextflow.config"

    tag "modules"
    tag "modules_amdphcore"
    tag "minimap2"
    tag "minimap2/validateindex"
    tag "nf-core/minimap2/index"

    // One real index per supported preset, built from the same genome.
    setup {
        run("MINIMAP2_INDEX") {
            script "../../../../nf-core/minimap2/index/main.nf"
            process {
                """
                def fasta = file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                input[0] = Channel.of(
                    [ [ id:'sr', preset:'sr' ], fasta ],
                    [ [ id:'asm20', preset:'asm20' ], fasta ]
                )
                """
            }
        }
    }

    test("sarscov2 - sr index - matching fasta - sr") {

        when {
            process {
                """
                input[0] = MINIMAP2_INDEX.out.index
                    .filter { meta, _index -> meta.preset == 'sr' }
                    .map { _meta, index -> [
                        [ id:'test' ],
                        index,
                        file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                    ] }
                input[1] = 'sr'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // The index is passed on unchanged under its original name.
                { assert process.out.index.size() == 1 },
                { assert snapshot(
                    file(process.out.index[0][1]).name,
                    process.out.versions
                ).match() }
            )
        }
    }

    test("sarscov2 - asm20 index - matching fasta - asm20") {

        when {
            process {
                """
                input[0] = MINIMAP2_INDEX.out.index
                    .filter { meta, _index -> meta.preset == 'asm20' }
                    .map { _meta, index -> [
                        [ id:'test' ],
                        index,
                        file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                    ] }
                input[1] = 'asm20'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.index.size() == 1 },
                { assert snapshot(
                    file(process.out.index[0][1]).name,
                    process.out.versions
                ).match() }
            )
        }
    }

    test("sarscov2 - sr index - wrong preset - fails") {

        when {
            process {
                """
                input[0] = MINIMAP2_INDEX.out.index
                    .filter { meta, _index -> meta.preset == 'sr' }
                    .map { _meta, index -> [
                        [ id:'test' ],
                        index,
                        file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                    ] }
                input[1] = 'asm20'
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("do not match preset 'asm20'") }
            )
        }
    }

    test("sarscov2 - sr index - different fasta - fails") {

        when {
            process {
                """
                input[0] = MINIMAP2_INDEX.out.index
                    .filter { meta, _index -> meta.preset == 'sr' }
                    .map { _meta, index -> [
                        [ id:'test' ],
                        index,
                        file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/genome/transcriptome.fasta', checkIfExists: true)
                    ] }
                input[1] = 'sr'
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("failed validation against transcriptome.fasta") }
            )
        }
    }

    test("sarscov2 - sr index - sr - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = MINIMAP2_INDEX.out.index
                    .filter { meta, _index -> meta.preset == 'sr' }
                    .map { _meta, index -> [
                        [ id:'test' ],
                        index,
                        file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                    ] }
                input[1] = 'sr'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
