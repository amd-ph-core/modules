// nf-core modules test tar
nextflow_process {

    name "Test Process TAR"
    script "../main.nf"
    process "TAR"

    tag "modules"
    tag "modules_phcore"
    tag "tar"
    tag "untar"

    setup {
        run("UNTAR") {
            script "../../untar/main.nf"
            process {
            """
            input[0] = [
                        [ id:'test' ], // meta map
                        file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/genome/db/kraken2.tar.gz', checkIfExists: true)
            ]
            """
            }
        }
    }

    test("sarscov2 - genome - db - kraken2 - none") {

        when {
            process {
                """
                // Prepare input data
                input[0] = UNTAR.out.untar
                input[1] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(process.out.archive[0][1]).name,
                    process.out.versions
                ).match() }
            )
        }

    }

    test("sarscov2 - genome - db - kraken2 - .gz") {

        when {
            process {
                """
                // Prepare input data
                input[0] = UNTAR.out.untar
                input[1] = '.gz'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(process.out.archive[0][1]).name,
                    process.out.versions
                ).match() }
            )
        }

    }

    test("sarscov2 - genome - db - kraken2 - stub") {

        options "-stub"

        when {
            process {
                """
                // Prepare input data
                input[0] = UNTAR.out.untar
                input[1] = '.gz'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
