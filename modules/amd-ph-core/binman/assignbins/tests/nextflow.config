// Used by one test only, to prove the thresholds really travel through ext.args rather than
// being read from `params` as they were before this module was promoted. 95% is above the
// fixture PAF's 92% (70 matches over a 76-base block), so every dense-panel hit must be
// rejected and only the translated-search hits survive.
process {
    withName: BINMAN_ASSIGNBINS {
        ext.args = '--rammap-min-identity 95'
    }
}
