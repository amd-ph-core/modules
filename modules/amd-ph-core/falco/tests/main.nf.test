nextflow_process {

    name "Test Process FALCO"
    script "../main.nf"
    process "FALCO"

    tag "modules"
    tag "modules_amdphcore"
    tag "falco"

    test("sarscov2 - fastq - single_end") {

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'test', single_end:true ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true) ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // MultiQC's fastqc/data pattern is "*fastqc_data.txt" - assert the
                // suffix explicitly so a rename cannot silently break MultiQC parsing.
                { assert process.out.txt[0][1] ==~ ".*/test_fastqc_data.txt" },
                // The embedded Filename, not the report path, is what MultiQC's
                // FastQC parser uses as the sample name. Asserting the path only
                // would pass while MultiQC still grouped under the input's name.
                { assert path(process.out.txt[0][1]).text =~ /(?m)^Filename\ttest\.fastq\.gz$/ },
                { assert process.out.html[0][1] ==~ ".*/test_fastqc_report.html" },
                { assert snapshot(
                    process.out.txt,
                    process.out.summary,
                    process.out.versions_falco
                ).match() }
            )
        }
    }

    test("sarscov2 - fastq - paired_end") {

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'test', single_end:false ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                      file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true) ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // Each mate must get its own files - a single falco invocation over
                // both mates would overwrite R1's output with R2's.
                //
                // The names come from the mate's position in the staged list, not
                // from its filename, so they are stable whatever the sequencer
                // called the input. Asserted explicitly: MultiQC derives sample
                // names from these filenames, so a rename silently splits or
                // merges samples in the report.
                { assert process.out.txt[0][1].size() == 2 },
                { assert process.out.txt[0][1][0] ==~ ".*/test_R1_fastqc_data.txt" },
                { assert process.out.txt[0][1][1] ==~ ".*/test_R2_fastqc_data.txt" },
                // The embedded Filename, not the report path, is what MultiQC's
                // FastQC parser uses as the sample name. Asserting the paths
                // only would pass while MultiQC still grouped both mates under
                // the input filenames.
                { assert path(process.out.txt[0][1][0]).text =~ /(?m)^Filename\ttest_R1\.fastq\.gz$/ },
                { assert path(process.out.txt[0][1][1]).text =~ /(?m)^Filename\ttest_R2\.fastq\.gz$/ },
                { assert snapshot(
                    process.out.txt,
                    process.out.summary,
                    process.out.versions_falco
                ).match() }
            )
        }
    }

    // A prefix with an apostrophe and a space stays one argument in every command.
    test("sarscov2 - fastq - paired_end - prefix with an apostrophe") {

        config "./prefix_apostrophe.config"

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'test', single_end:false ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                      file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true) ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.txt[0][1].collect { f -> file(f).name } == ["O'Brien 1_R1_fastqc_data.txt", "O'Brien 1_R2_fastqc_data.txt"] },
                { assert path(process.out.txt[0][1][0]).text =~ /(?m)^Filename\tO'Brien 1_R1\.fastq\.gz$/ },
            )
        }
    }

    // falco 2.x fails on a FASTQ with no reads (gzipped: exit 1, "failed to read header";
    // plain: a floating-point exception). The module skips such a mate instead, so one
    // empty sample does not stop a run; it simply has no report.
    test("empty - fastq - single_end - gzipped and plain") {

        when {
            def dir = new File("${outputDir}/empty_input")
            dir.mkdirs()
            new java.util.zip.GZIPOutputStream(new FileOutputStream(new File(dir, 'empty.fastq.gz'))).close()
            new File(dir, 'empty.fastq').text = ''
            process {
                """
                input[0] = channel.of(
                    [ [ id:'empty_gz', single_end:true ], [ file('${dir}/empty.fastq.gz', checkIfExists: true) ] ],
                    [ [ id:'empty_plain', single_end:true ], [ file('${dir}/empty.fastq', checkIfExists: true) ] ]
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.trace.tasks().size() == 2 },
                { assert process.out.txt.size() == 0 },
                { assert process.out.summary.size() == 0 },
                { assert process.out.html.size() == 0 }
            )
        }
    }

    test("sarscov2 - fastq - paired_end - one empty mate") {

        when {
            def dir = new File("${outputDir}/empty_mate")
            dir.mkdirs()
            new java.util.zip.GZIPOutputStream(new FileOutputStream(new File(dir, 'empty_2.fastq.gz'))).close()
            process {
                """
                input[0] = channel.of([
                    [ id:'test', single_end:false ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                      file('${dir}/empty_2.fastq.gz', checkIfExists: true) ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // R1 is reported as usual; R2, with no reads, is not.
                { assert process.out.txt.size() == 1 },
                { assert process.out.txt[0][1] ==~ ".*/test_R1_fastqc_data.txt" },
                { assert path(process.out.txt[0][1]).text =~ /(?m)^Filename\ttest_R1\.fastq\.gz$/ }
            )
        }
    }

    test("sarscov2 - fastq - single_end - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'test', single_end:true ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true) ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("sarscov2 - fastq - paired_end - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'test', single_end:false ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                      file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true) ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // The stub must mirror the real paired-end naming, or downstream
                // stub runs will not exercise MultiQC's parsing path.
                { assert process.out.txt[0][1][0] ==~ ".*/test_R1_fastqc_data.txt" },
                { assert process.out.txt[0][1][1] ==~ ".*/test_R2_fastqc_data.txt" },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
