// extract_kraken_reads_parallel.py ships in the module's resources/usr/bin, which
// Nextflow only puts on PATH with module binaries enabled.
nextflow.enable.moduleBinaries = true

process {
    withName: KRAKEN2_EXTRACTREADS {
        // meta.exclude switches to Talos-style host removal: keep every read
        // that is NOT assigned to the taxid.
        ext.args2 = { meta.exclude ? '--exclude' : '' }
    }
}
