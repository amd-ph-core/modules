nextflow_process {

    name "Test Process FASTPLONG"
    script "../main.nf"
    process "FASTPLONG"
    config "./nextflow.config"

    tag "modules"
    tag "modules_amdphcore"
    tag "fastplong"

    // nf-core's 100 SARS-CoV-2 Nanopore reads. With the default filters a few
    // fail; with quality and length filtering off none do, which is when
    // fastplong leaves a zero-byte --failed_out that this module repairs.

    test("nanopore - default filters - failed reads saved") {
        when {
            params {
                module_args = ""
            }
            process {
                """
                input[0] = [ [ id:'test', single_end:true ],
                    file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/nanopore/fastq/test.fastq.gz', checkIfExists: true) ]
                input[1] = []
                input[2] = false
                input[3] = true
                """
            }
        }
        then {
            def passed = path(process.out.reads[0][1]).linesGzip.size().intdiv(4)
            def failed = path(process.out.reads_fail[0][1]).linesGzip.size().intdiv(4)
            assertAll(
                { assert process.success },
                { assert passed > 0 && failed > 0 },
                { assert passed + failed == 100 },
                { assert snapshot(
                    process.out.reads,
                    process.out.reads_fail,
                    process.out.findAll { key, _val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("nanopore - no read fails - failed-reads file is a valid empty gzip") {
        when {
            params {
                module_args = "--disable_quality_filtering --disable_length_filtering"
            }
            process {
                """
                input[0] = [ [ id:'test', single_end:true ],
                    file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/nanopore/fastq/test.fastq.gz', checkIfExists: true) ]
                input[1] = []
                input[2] = false
                input[3] = true
                """
            }
        }
        then {
            def fail = path(process.out.reads_fail[0][1])
            assertAll(
                { assert process.success },
                // A zero-byte file is not gzip: reading it throws "unexpected end of file".
                { assert fail.toFile().length() > 0 },
                { assert fail.linesGzip.size() == 0 },
                { assert path(process.out.reads[0][1]).linesGzip.size().intdiv(4) == 100 }
            )
        }
    }

    test("nanopore - stub") {
        options "-stub"
        when {
            params {
                module_args = ""
            }
            process {
                """
                input[0] = [ [ id:'test', single_end:true ],
                    file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/nanopore/fastq/test.fastq.gz', checkIfExists: true) ]
                input[1] = []
                input[2] = false
                input[3] = true
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
