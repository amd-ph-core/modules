// The shell nf-core pipelines run tasks with (the template's process.shell):
// -C (noclobber) included, so the module is tested the way pipelines run it.
process.shell = ['/bin/bash', '-C', '-e', '-u', '-o', 'pipefail']

process {
    withName: 'FASTPLONG' {
        ext.args = params.module_args
    }
}
