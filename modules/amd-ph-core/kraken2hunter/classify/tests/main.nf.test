nextflow_process {

    name "Test Process KRAKEN2HUNTER_CLASSIFY"
    script "../main.nf"
    process "KRAKEN2HUNTER_CLASSIFY"
    config "./nextflow.config"

    tag "modules"
    tag "modules_amdphcore"
    tag "kraken2hunter"
    tag "kraken2hunter/classify"

    // A live classification test needs an untarred Kraken 2 database directory. This repo does
    // not vendor nf-core/untar, so there is no in-repo way to expand the sarscov2 kraken2
    // fixture yet, and a test that silently skipped would be worse than one that is absent.
    //
    // The binning behaviour IS verified, manually, against the 16 GB standard database:
    // 100,000 rRNA-depleted wastewater pairs, `--bin-rank family --bin-include-clade 10239`,
    // produced 16 family bins plus one unresolved bin in 7.6 s, and the 22.95% classified
    // fraction matched plain kraken2 2.17.1 on the same reads to three significant figures.
    // See the binman pipeline's docs/ for that measurement. Vendoring nf-core/untar is the one
    // step needed to turn that into a live test here, and it is tracked as follow-up.

    test("stub - paired end, family rank") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    [
                        file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                input[1] = []
                input[2] = 'family'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match("paired_family_stub") }
            )
        }
    }

    test("stub - single end, genus rank") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ],
                    file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true)
                ]
                input[1] = []
                input[2] = 'genus'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match("single_genus_stub") }
            )
        }
    }
}
