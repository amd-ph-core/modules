// `docker.registry` is cleared because tests/config/nf-test.config sets it to the quay mirror,
// which must not be prepended to an already fully-qualified ECR name.
docker.registry      = ''
podman.registry      = ''
singularity.registry = ''

process {
    withName: KRAKEN2HUNTER_CLASSIFY {
        // Bin to family, viruses only, gzipped, and keep the unresolved bin. --bin-include-clade
        // 10239 restricts bins to the Viruses subtree: without it, a standard-database run on a
        // metagenome opens a bin for every bacterial family present, which is thousands of
        // files and is not what this pipeline is binning for yet.
        ext.args = [
            '--bin-compression gzip',
            '--bin-compression-level 1',
            '--bin-include-clade 10239',
            '--bin-unresolved write',
            '--max-open-bin-files 128',
            '--bin-min-fragments 1',
        ].join(' ')
    }
}
